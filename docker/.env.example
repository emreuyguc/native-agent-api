# Docker env file: one installation of native-agent-api. It holds Compose and container settings
# only; the application settings stay in the file CONTAINER_APP_ENV_FILE names. Copy it per
# installation, e.g. docker/claude.env, and pass it to every command from the repository root:
#   docker compose --env-file docker/claude.env up -d --build
# Values are not quoted, and a `$` starts a Compose variable. A variable set in your shell
# overrides this file.

# ---------------------------------------------------------------- Compose

# Installation name: the Compose project and the prefix of its volumes (<name>-home, -data,
# -projects). Each installation needs its own name; its login lives in its home volume.
COMPOSE_PROJECT_NAME=native-agent-api-claude

# Compose files, relative to the repository root.
#   docker/compose.yaml                             Open egress.
#   docker/compose.yaml:docker/compose.egress.yaml  Only the hosts in CONTAINER_EGRESS_ALLOW_FILE.
COMPOSE_FILE=docker/compose.yaml

# ---------------------------------------------------------------- Container

# Agent image: claude or codex (docker/<agent>/Dockerfile). It must equal NATIVE_AGENT_AGENT in
# the application env file; otherwise the container reports unhealthy.
CONTAINER_AGENT=claude

# Application env file: absolute, or relative to the docker directory. Start from /.env.example
# and set the container values listed in docker/README.md.
CONTAINER_APP_ENV_FILE=/absolute/path/to/native-agent-api.claude.env

# Image tag. Change it to a pinned registry tag or digest for deployment.
CONTAINER_IMAGE=native-agent-api-claude:local

# Published host interface and port. Each installation needs its own port.
#   127.0.0.1  Only this machine.
#   0.0.0.0    Every interface.
CONTAINER_PUBLISH_ADDR=127.0.0.1
CONTAINER_PUBLISH_PORT=8701

# Resource limits for the server and its child processes.
#   MEMORY  Docker size: 512m, 1g, 2g ... (builds and test runs need more).
#   CPUS    Fractional CPUs: 0.5, 1.0, 2.0 ...
CONTAINER_MEMORY=1g
CONTAINER_CPUS=1.0

# Egress allowlist for docker/compose.egress.yaml, relative to the docker directory:
# ./claude/egress-allow.txt or ./codex/egress-allow.txt.
CONTAINER_EGRESS_ALLOW_FILE=./claude/egress-allow.txt

# ---------------------------------------------------------------- Build

# Pinned build images. Update the tag and digest together.
GO_IMAGE=golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf
RUNTIME_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Explicit build identity. Supply values from the commit being built:
#   git describe --tags --always --dirty; git rev-parse HEAD; git show -s --format=%cI HEAD
BUILD_VERSION=0.0.0-dev
BUILD_COMMIT=0000000000000000000000000000000000000000
BUILD_DATE=1970-01-01T00:00:00Z
