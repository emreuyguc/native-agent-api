# Docker env file: the choices of one installation of native-agent-api. Copy it per installation,
# e.g. docker/claude.env, and pass it to every command from the repository root:
#   docker compose --env-file docker/claude.env up -d --build
# Values are not quoted, and a `$` starts a Compose variable. A variable set in your shell
# overrides this file.

# Installation name: the Compose project and the prefix of its volumes (<name>-home, -data,
# -projects). Each installation needs its own name; its login lives in its home volume.
COMPOSE_PROJECT_NAME=native-agent-api-claude

# Compose files, relative to the repository root, separated by `:`.
#   docker/compose.yaml          Required first. Builds the image from source, with open egress.
#   docker/compose.egress.yaml   Add it: only the hosts in docker/<agent>/egress-allow.txt.
#   docker/compose.release.yaml  Add it: run the published image of CONTAINER_RELEASE instead.
COMPOSE_FILE=docker/compose.yaml

# Release to run with compose.release.yaml, for example 0.2.0 (see the GitHub releases).
# Leave it empty when you build from source.
CONTAINER_RELEASE=

# Agent the container serves: claude or codex.
CONTAINER_AGENT=claude

# Application env file: absolute, or relative to the docker directory. It holds the token,
# logging and gateway limits (see docker/README.md).
CONTAINER_APP_ENV_FILE=./claude.app.env

# Published host interface and port. Each installation needs its own port.
#   127.0.0.1  Only this machine.
#   0.0.0.0    Every interface.
CONTAINER_PUBLISH_ADDR=127.0.0.1
CONTAINER_PUBLISH_PORT=8701

# Resource limits for the server and its child processes.
#   MEMORY  Docker size: 512m, 1g, 2g ... (builds and test runs need more).
#   CPUS    Fractional CPUs: 0.5, 1.0, 2.0 ...
CONTAINER_MEMORY=1g
CONTAINER_CPUS=1.0
