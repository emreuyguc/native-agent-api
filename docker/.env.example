# Complete application env file created outside the docker directory. It must use container paths,
# including LISTEN=0.0.0.0:8080, SANDBOX_MODE=external, DATA_DIR=/data, PROFILE_DIR=native and
# ALLOWED_ROOTS=/projects.
CLAUDE_APP_ENV_FILE=/absolute/path/to/native-agent-api.claude.env
CODEX_APP_ENV_FILE=/absolute/path/to/native-agent-api.codex.env

# Pinned build images. Update the tag and digest together.
GO_IMAGE=golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb
RUNTIME_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Explicit build identity. Supply values from the commit being built.
BUILD_VERSION=0.0.0-dev
BUILD_COMMIT=0000000000000000000000000000000000000000
BUILD_DATE=1970-01-01T00:00:00Z

# Claude Docker image. Change this to a pinned registry tag or digest for deployment.
CLAUDE_IMAGE=native-agent-api-claude:local

# Published host interface and port.
#   127.0.0.1  Only this machine.
#   0.0.0.0    Every interface: the app env file must then set a token.
CLAUDE_HOST=127.0.0.1
CLAUDE_PORT=8701

# Container resource limits for the Claude server and its child processes.
#   MEMORY_LIMIT  Docker size: 512m, 1g, 2g ... (builds and test runs need more).
#   CPUS          Fractional CPUs: 0.5, 1.0, 2.0 ...
CLAUDE_MEMORY_LIMIT=1g
CLAUDE_CPUS=1.0

# Egress allowlist, used only with compose.claude.egress.yaml (relative to the docker directory).
CLAUDE_EGRESS_ALLOW_FILE=./claude/egress-allow.txt

# Codex Docker image. Change this to a pinned registry tag or digest for deployment.
CODEX_IMAGE=native-agent-api-codex:local

# Published host interface and port for the Codex service (same choices as CLAUDE_HOST).
CODEX_HOST=127.0.0.1
CODEX_PORT=8702

# Container resource limits for the Codex server and its child processes (as above).
CODEX_MEMORY_LIMIT=1g
CODEX_CPUS=1.0

# Egress allowlist, used only with compose.codex.egress.yaml (relative to the docker directory).
CODEX_EGRESS_ALLOW_FILE=./codex/egress-allow.txt
