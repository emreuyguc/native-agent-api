# native-agent-api configuration. Pass it with `serve --env-file <file>`; the file must have mode
# 0600. A variable set in the process environment overrides the same variable in this file.
# Every value below is validated at startup; an invalid value stops the server with a message.

# Native adapter served by this process.
#   claude  Claude Code (`claude` on PATH)
#   codex   Codex CLI (`codex` on PATH)
NATIVE_AGENT_AGENT=claude

# Who isolates the commands the agent runs.
#   cli       The CLI's own OS sandbox (Seatbelt on macOS, bubblewrap on Linux). Runs fail when it
#             is unavailable. Use it on a host.
#   external  The CLI sandbox is disabled because an outer boundary (the provided containers)
#             already isolates the process; bubblewrap cannot create namespaces there.
NATIVE_AGENT_SANDBOX_MODE=cli

# Listener address as ip:port (IPv6 as [::1]:8080).
#   127.0.0.1:8080  Loopback: only this machine. A token is optional.
#   0.0.0.0:8080    Every interface: a token is required (see ALLOW_UNAUTHENTICATED).
NATIVE_AGENT_LISTEN=127.0.0.1:8080

# Source address allowlist: comma-separated IPs or CIDRs, e.g. 10.0.0.0/8,192.168.1.20.
#   empty  Every source that can reach the listener.
NATIVE_AGENT_ALLOWED_IPS=

# Client authentication: set at most one of the three; all empty means no token.
#   TOKEN_SHA256       Recommended. The hex SHA-256 of the client token; the token itself is never
#                      stored. `native-agent-api new-token` prints a token and its digest.
#   TOKEN_SHA256_FILE  Absolute path of a file holding that digest (container secrets).
#   TOKEN              The plain token, at least 32 characters. Anyone who reads this file can use it.
# Clients send `Authorization: Bearer <token>`.
NATIVE_AGENT_TOKEN=
NATIVE_AGENT_TOKEN_SHA256=
NATIVE_AGENT_TOKEN_SHA256_FILE=

# Running without a token. Valid on any LISTEN; on loopback a token is optional either way.
#   false  A non-loopback listener refuses to start without a token.
#   true   No token is required anywhere. Cannot be combined with a token. On a non-loopback
#          listener anyone who can reach the port controls the agent: limit access with
#          ALLOWED_IPS or a firewall.
NATIVE_AGENT_ALLOW_UNAUTHENTICATED=false

# Log severity: debug, info, warn or error. debug adds per-event agent detail.
NATIVE_AGENT_LOG_LEVEL=info

# Log encoding.
#   json     One JSON object per line, for collectors and containers.
#   text     Plain key=value lines.
#   console  Colored, human-readable output for an interactive terminal.
NATIVE_AGENT_LOG_FORMAT=json

# One metadata record per HTTP request (method, path, status, size, duration, request_id).
#   true | false
NATIVE_AGENT_LOG_REQUESTS=true

# Request/response bodies in the request log. They may contain prompts and private data.
#   false  Never logged.
#   true   Logged up to LOG_BODY_LIMIT bytes each; requires LOG_REQUESTS=true and LOG_BODY_LIMIT > 0.
NATIVE_AGENT_LOG_BODIES=false
# Bytes per logged body: 0 to 1048576.
NATIVE_AGENT_LOG_BODY_LIMIT=4096

# API reference at /docs and the OpenAPI documents, served without authentication.
#   true | false  (false: those paths are not served)
NATIVE_AGENT_DOCS=true

# Absolute directory for the gateway's own data: managed workspaces, attachment and session
# records (workspaces/) and the maintenance-command directory (work/). Not /. Replace the example.
NATIVE_AGENT_DATA_DIR=/absolute/path/to/native-agent-api-data

# Host directories that clients may attach as workspaces or pass as extra directories:
# comma-separated absolute paths, at most 64, not /.
#   empty  Attaching host directories is disabled; only managed workspaces exist.
NATIVE_AGENT_ALLOWED_ROOTS=

# Agent profile: the CLI's settings, login, skills, plugins and session history.
#   native         The CLI's own location under HOME (~/.claude, ~/.codex), exactly as your
#                  terminal uses it, including an existing login.
#   /absolute/dir  A separate profile for the gateway; it needs its own login. The native
#                  directory itself is rejected as a path: use native instead.
NATIVE_AGENT_PROFILE_DIR=native

# Concurrently running native CLI processes: 1 to 16. An open interactive run holds a slot until
# it ends; a request over the limit gets 429 gateway_busy.
NATIVE_AGENT_MAX_CONCURRENT=2

# Maximum duration of one agent turn, in seconds: 10 to 1800. It also bounds how long the agent
# may keep running after its input closed (Claude Code waits for background tasks); then the run's
# processes are stopped and the answer keeps its status.
NATIVE_AGENT_QUERY_TIMEOUT_SECONDS=480

# Timeout of maintenance commands (version, login status, models, usage), in seconds: 1 to 300.
NATIVE_AGENT_COMMAND_TIMEOUT_SECONDS=15

# Maximum duration of one API-driven native login, from start until the browser step finishes,
# in seconds: 60 to 3600.
NATIVE_AGENT_LOGIN_TIMEOUT_SECONDS=900

# How long a finished run and its events stay readable, in seconds: 10 to 86400.
NATIVE_AGENT_RUN_RETENTION_SECONDS=600

# Finished runs kept in memory within that window: 1 to 10000. The oldest are dropped first.
NATIVE_AGENT_MAX_RETAINED_RUNS=200

# Stored events per run, including its terminal event: 16 to 1000000. Live-only chunks (partial
# text, command output deltas) are streamed but not stored.
NATIVE_AGENT_MAX_RUN_EVENTS=10000

# Native task, subagent and process observations kept per run: 1 to 100000.
NATIVE_AGENT_MAX_RUN_OBSERVATIONS=256

# An open interactive run with no new turn for this long is closed, in seconds: 10 to 3600.
NATIVE_AGENT_RUN_IDLE_SECONDS=300

# Size limits, in bytes.
#   MAX_BODY_BYTES    JSON request body: 1024 to 16000000.
#   MAX_OUTPUT_BYTES  Stored CLI output of one turn, and its largest single line:
#                     65536 to 64000000. A turn over it fails.
#   MAX_FILE_BYTES    One uploaded file: 1048576 to 2147483648.
#   MAX_LIST_ENTRIES  Entries one directory listing or directory copy may contain: 1 to 100000.
NATIVE_AGENT_MAX_BODY_BYTES=2000000
NATIVE_AGENT_MAX_OUTPUT_BYTES=16000000
NATIVE_AGENT_MAX_FILE_BYTES=536870912
NATIVE_AGENT_MAX_LIST_ENTRIES=10000

# Optional outbound proxy for the CLI and the tools it starts, passed on only when set (either
# case): HTTPS_PROXY, HTTP_PROXY, ALL_PROXY, NO_PROXY. Unset: direct connections.
# HTTPS_PROXY=http://proxy.example:8888
